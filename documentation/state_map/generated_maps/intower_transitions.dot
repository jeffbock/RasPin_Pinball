    "EXIT_TOWER" [label="Exit Tower"];
  }
  legend [shape=plain, label=<<TABLE BORDER='1' COLOR='#cbd5e1' CELLBORDER='0' CELLSPACING='0' CELLPADDING='4'><TR><TD COLSPAN='4'><B>Legend</B></TD></TR><TR><TD BGCOLOR='#2563eb' WIDTH='12'></TD><TD ALIGN='LEFT'>table-state</TD><TD BGCOLOR='#7c3aed' WIDTH='12'></TD><TD ALIGN='LEFT'>mode-entry</TD></TR><TR><TD BGCOLOR='#7c3aed' WIDTH='12'></TD><TD ALIGN='LEFT'>mode-exit</TD><TD BGCOLOR='#15803d' WIDTH='12'></TD><TD ALIGN='LEFT'>success</TD></TR><TR><TD BGCOLOR='#dc2626' WIDTH='12'></TD><TD ALIGN='LEFT'>failure</TD><TD BGCOLOR='#d97706' WIDTH='12'></TD><TD ALIGN='LEFT'>conditional</TD></TR><TR><TD BGCOLOR='#64748b' WIDTH='12'></TD><TD ALIGN='LEFT'>loop</TD><TD BGCOLOR='#64748b' WIDTH='12'></TD><TD ALIGN='LEFT'>external</TD></TR></TABLE>>];
  "TOWER_INIT" -> "TOWER_CLIMB" [label="Initialize player tower state\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "TOWER_CLIMB" -> "ROOM_FIGHT" [label="Selected door opens into a room with enemies\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "TOWER_CLIMB" -> "FLOOR_CHALLENGE_VIDEO" [label="Selected staircase door opens\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "ROOM_FIGHT" -> "ROOM_FIGHT" [label="D20 resolution leaves enemies alive\\n[loop]", color="#64748b", fontcolor="#64748b", style="solid"];
  "ROOM_FIGHT" -> "FLOOR_CHALLENGE_VIDEO" [label="Staircase room cleared\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "ROOM_FIGHT" -> "DRAGON_VIDEO" [label="Dragon room cleared\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "ROOM_FIGHT" -> "TOWER_CLIMB" [label="Ordinary room cleared\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "FLOOR_CHALLENGE_VIDEO" -> "FLOOR_CHALLENGE_FIGHT" [label="Champion joined; video completes or is skipped\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "FLOOR_CHALLENGE_VIDEO" -> "EXIT_TOWER" [label="Required champion missing\\n[conditional]", color="#d97706", fontcolor="#d97706", style="dotted"];
  "FLOOR_CHALLENGE_FIGHT" -> "FLOOR_CHALLENGE_SUCCESS" [label="D20 result meets challenge target\\n[success]", color="#15803d", fontcolor="#15803d", style="solid"];
  "FLOOR_CHALLENGE_FIGHT" -> "EXIT_TOWER" [label="D20 result misses challenge target or critically fails\\n[failure]", color="#dc2626", fontcolor="#dc2626", style="solid"];
  "FLOOR_CHALLENGE_SUCCESS" -> "TOWER_CLIMB" [label="Success animation completes\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "EXIT_TOWER" -> "TOWER_CLIMB" [label="Returns to PBTBL_MAIN / MODE_NORMAL_PLAY\\n[external]", color="#64748b", fontcolor="#64748b", style="dashed"];
}
