    "FLOOR_CHALLENGE_FIGHT" [label="Challenge Roll"];
    "FLOOR_CHALLENGE_SUCCESS" [label="Challenge Success"];
  }
  subgraph cluster_4 {
    label="Exit";
    color="#cbd5e1";
    style="rounded";
    penwidth=1.2;
