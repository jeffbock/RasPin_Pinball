// Generated by scripts/generate_state_map.py. Do not edit manually.
digraph StateMap {
  graph [rankdir=LR, bgcolor="#ffffff", fontname="Arial", pad=0.35, nodesep=0.55, ranksep=0.9];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#334155", fontname="Arial", margin="0.18,0.11"];
  edge [fontname="Arial", fontsize=10, arrowsize=0.75];
  label="Dragons of Destiny Table Flow";
  labelloc="t";
  fontsize=20;
  fontname="Arial Bold";
  subgraph cluster_0 {
    label="Lifecycle";
    color="#cbd5e1";
    style="rounded";
    penwidth=1.2;
    "PBTBL_INIT" [label="Init"];
    "PBTBL_START" [label="Start / Attract"];
    "PBTBL_GAMEEND" [label="Game End"];
    "PBTBL_RESET" [label="Reset Confirm"];
    "ACTIVE_TABLE_STATE" [label="Active Table State\n(before reset)"];
  }
  subgraph cluster_1 {
    label="Gameplay";
    color="#cbd5e1";
    style="rounded";
    penwidth=1.2;
    "PBTBL_MAIN" [label="Main Play"];
    "PBTBL_PLAYEREND" [label="Player End"];
  }
  subgraph cluster_2 {
    label="Adventure";
    color="#cbd5e1";
    style="rounded";
    penwidth=1.2;
    "PBTBL_INTOWER" [label="InTower"];
    "PBTBL_DRAGONMULTIBALL" [label="Dragon Multiball"];
  }
  legend [shape=plain, label=<<TABLE BORDER='1' COLOR='#cbd5e1' CELLBORDER='0' CELLSPACING='0' CELLPADDING='4'><TR><TD COLSPAN='4'><B>Legend</B></TD></TR><TR><TD BGCOLOR='#2563eb' WIDTH='12'></TD><TD ALIGN='LEFT'>table-state</TD><TD BGCOLOR='#7c3aed' WIDTH='12'></TD><TD ALIGN='LEFT'>mode-entry</TD></TR><TR><TD BGCOLOR='#7c3aed' WIDTH='12'></TD><TD ALIGN='LEFT'>mode-exit</TD><TD BGCOLOR='#15803d' WIDTH='12'></TD><TD ALIGN='LEFT'>success</TD></TR><TR><TD BGCOLOR='#dc2626' WIDTH='12'></TD><TD ALIGN='LEFT'>failure</TD><TD BGCOLOR='#d97706' WIDTH='12'></TD><TD ALIGN='LEFT'>conditional</TD></TR><TR><TD BGCOLOR='#64748b' WIDTH='12'></TD><TD ALIGN='LEFT'>loop</TD><TD BGCOLOR='#64748b' WIDTH='12'></TD><TD ALIGN='LEFT'>external</TD></TR></TABLE>>];
  "PBTBL_INIT" -> "PBTBL_START" [label="Initialization complete\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_START" -> "PBTBL_MAIN" [label="Start pressed; door animation completes\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_MAIN" -> "PBTBL_PLAYEREND" [label="Ball drain; another player remains\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_MAIN" -> "PBTBL_GAMEEND" [label="Ball drain; no enabled players remain\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_PLAYEREND" -> "PBTBL_MAIN" [label="IDI_BALLDELIVERED\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_MAIN" -> "PBTBL_INTOWER" [label="IDI_TOWER; enter MODE_INTOWER\\n[mode-entry]", color="#7c3aed", fontcolor="#7c3aed", style="dashed"];
  "PBTBL_INTOWER" -> "PBTBL_DRAGONMULTIBALL" [label="Dragon video completes or is skipped\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_INTOWER" -> "PBTBL_MAIN" [label="Tower exit timeout; enter MODE_NORMAL_PLAY\\n[mode-exit]", color="#7c3aed", fontcolor="#7c3aed", style="dashed"];
  "PBTBL_DRAGONMULTIBALL" -> "PBTBL_MAIN" [label="Dragon result display completes; enter MODE_NORMAL_PLAY\\n[mode-exit]", color="#7c3aed", fontcolor="#7c3aed", style="dashed"];
  "PBTBL_GAMEEND" -> "PBTBL_START" [label="Game-end timer or button press\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "ACTIVE_TABLE_STATE" -> "PBTBL_RESET" [label="IDI_RESET; store m_StateBeforeReset\\n[conditional]", color="#d97706", fontcolor="#d97706", style="dotted"];
  "PBTBL_RESET" -> "PBTBL_START" [label="IDI_RESET confirmed\\n[table-state]", color="#2563eb", fontcolor="#2563eb", style="solid"];
  "PBTBL_RESET" -> "ACTIVE_TABLE_STATE" [label="Cancel; restore m_StateBeforeReset\\n[conditional]", color="#d97706", fontcolor="#d97706", style="dotted"];
}
